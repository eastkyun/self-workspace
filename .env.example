# Nest development configuration.
# Copy to .env only when your process runner loads dotenv files. Never commit
# passwords, tokens, cookie values, or other credentials.

APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000

# Required explicit safety assertion when running the bootstrap migration CLI.
# Set only while the deployment is stopped or confirmed single-worker.
WORKSPACE_SINGLE_WORKER_ASSERTED=true

# Existing domain database boundaries (kept as separate SQLite files).
CALENDAR_DB_PATH=instance/calendar/tasks.db
NOTES_DB_PATH=instance/notes/notes.db
PUBLISHING_DB_PATH=instance/publishing/publishing.db
ASSET_DB_PATH=instance/assets/assets.db
PUBLICATION_TYPES_PATH=instance/publishing/types.json

# Identity is introduced in Phase 1 and remains a separate SQLite database.
IDENTITY_DB_PATH=instance/identity/identity.db

# Opaque server-session policy. Session and CSRF token values are generated at
# runtime and must never be configured here.
SESSION_COOKIE_NAME=my_workspace_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_MAX_ACTIVE_PER_USER=10
SESSION_LAST_SEEN_INTERVAL_SECONDS=300

INVITATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_FAILURES=5

# Empty by default: reverse-proxy headers are not trusted unless explicitly set.
# TRUSTED_PROXIES=127.0.0.1,::1

# Server-side Markdown document export. Install Pandoc, XeLaTeX, and the named
# CJK font on the host. A custom reference DOCX is optional.
DOCUMENT_EXPORT_PANDOC_PATH=pandoc
DOCUMENT_EXPORT_XELATEX_PATH=xelatex
DOCUMENT_EXPORT_CHROMIUM_PATH=chromium
DOCUMENT_EXPORT_PDF_ENGINE=chromium
DOCUMENT_EXPORT_CJK_FONT=Noto Sans CJK KR
DOCUMENT_EXPORT_TIMEOUT_SECONDS=60
DOCUMENT_EXPORT_MAX_CONCURRENT=2
# DOCUMENT_EXPORT_REFERENCE_DOCX=/opt/my-workspace/reference.docx

# Jobs remains opt-in. Do not enable Web Collection in production until an
# outbound firewall/proxy and browser CPU/RAM limits have been verified.
JOBS_DB_PATH=instance/jobs/jobs.db
JOBS_ENABLED=false
JOBS_WEB_COLLECTION_ENABLED=false
JOBS_MINIMUM_INTERVAL_SECONDS=300
JOBS_LEASE_SECONDS=60
JOBS_HEARTBEAT_SECONDS=20
JOBS_BROWSER_CONCURRENCY=2
# OPENAI_API_KEY=secret-manager에서 주입
JOBS_OPENAI_MODEL=gpt-5.6-luna
JOBS_OPENAI_TIMEOUT_SECONDS=180
